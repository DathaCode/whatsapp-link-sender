{
  "name": "wa-link-sender",
  "version": "3.0.0",
  "private": true,
  "description": "Paste a Facebook / TikTok / YouTube link and send it to WhatsApp groups your number is already in",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "dev:web": "npm --prefix web run dev",
    "build": "tsc -p tsconfig.json",
    "build:web": "npm --prefix web run build",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "reset-admin": "node dist/cli.js reset-admin"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^18.0.8",
    "drizzle-orm": "^0.45.4",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "pino": "^10.4.0",
    "qrcode": "^1.5.4",
    "whatsapp-web.js": "1.34.7",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.19.0",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^7.2.1",
    "drizzle-kit": "^0.31.11",
    "supertest": "^7.3.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4"
  }
}
