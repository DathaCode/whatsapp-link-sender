# ─────────────────────────────────────────────────────────────
#  wa-link-sender settings. Copy this file to .env and edit.
#  The app checks these on start-up and tells you exactly what is wrong.
# ─────────────────────────────────────────────────────────────

# Web port. 3000 is often taken, so 3100 is the default.
# With Docker the page is at http://localhost:PORT (this machine only).
PORT=3100

# Password your team types on the sign-in page. REQUIRED, at least 12 characters.
# Generate one in PowerShell:  -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 32 | % {[char]$_})
# or on Linux:                 openssl rand -base64 24
ACCESS_KEY=change-me-to-a-long-secret

# Time zone for sending hours and the daily limit (IANA name).
TZ=Asia/Colombo

# ── Safety (lower ban risk). These are defaults; the Settings page can change them. ──

# Random pause between two groups, in seconds (minimum 5).
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=40

# Most messages the number may send per day (each group counts as one message).
DAILY_MESSAGE_CAP=150

# Sending hours, 24-hour HH:MM in TZ. Sends outside these hours wait until the window opens.
# The window may cross midnight (e.g. 20:00 to 02:00).
SEND_WINDOW_START=08:00
SEND_WINDOW_END=21:00

# ── Optional ──

# Domain for the HTTPS proxy profile (docker compose --profile proxy up -d).
# DOMAIN=links.example.com

# Log detail: fatal, error, warn, info, debug, trace
# LOG_LEVEL=info

# Only for running without Docker (npm run dev). Docker sets these itself.
# DATA_DIR=./data
# WWEBJS_AUTH_DIR=./.wwebjs_auth
# WWEBJS_CACHE_DIR=./.wwebjs_cache
# HEADLESS=true
