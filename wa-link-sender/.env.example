# ─────────────────────────────────────────────────────────────
#  wa-link-sender settings. Copy this file to .env and edit.
#  The app checks these on start-up and tells you exactly what is wrong.
#  Generate random values:  openssl rand -base64 48
#  (PowerShell: [Convert]::ToBase64String((1..48 | % {Get-Random -Max 256})))
# ─────────────────────────────────────────────────────────────

# Web port. 3000 is often taken, so 3100 is the default.
# With Docker the page is at http://localhost:PORT (this machine only).
PORT=3100

# Time zone for sending hours, the daily limit, nightly jobs and how times are shown.
TZ=Asia/Colombo

# ── First admin account ──
# Used ONLY on the very first start, when no users exist yet. The admin must
# choose a new password at first sign-in. After that these values are ignored
# (you can remove the password from this file).
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_PASSWORD=change-me-at-least-10-chars

# ── Sessions & sign-in ──
# REQUIRED: long random secret (32+ characters). Signs the anti-CSRF tokens.
# Changing it makes every open page reload its token (users stay signed in).
SESSION_SECRET=change-me-to-a-long-random-secret-of-32-or-more-chars

# Sign out after this many hours without activity, and after this many days in any case.
SESSION_IDLE_HOURS=8
SESSION_MAX_DAYS=7

# Lock an account for LOGIN_LOCK_MINUTES after LOGIN_MAX_ATTEMPTS wrong passwords.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15

# Which proxies may tell the app the real client IP (X-Forwarded-For) and https.
# Default trusts the local machine and private Docker networks (the bundled Caddy proxy).
# Use "false" if the app is reached directly, or e.g. "1" for exactly one proxy hop.
TRUST_PROXY=loopback, uniquelocal

# ── Audit log & backups ──
# Audit entries older than this are pruned nightly (minimum 30).
AUDIT_RETENTION_DAYS=365
# Nightly database backups (02:30 in TZ) kept in DATA_DIR/backups.
BACKUP_KEEP=14
# Attached images are deleted after this many days (history then shows "image expired").
UPLOAD_RETENTION_DAYS=90

# ── Sending safety (defaults; the Settings page can change them) ──
# Random pause between two groups, in seconds (minimum 5).
MIN_DELAY_SECONDS=15
MAX_DELAY_SECONDS=40
# Most messages each WhatsApp number may send per day (each group = one message).
DAILY_MESSAGE_CAP=150
# Sending hours, 24-hour HH:MM in TZ. Outside them, sends wait. May cross midnight.
SEND_WINDOW_START=08:00
SEND_WINDOW_END=21:00

# ── Optional ──
# Domain for the HTTPS proxy profile (docker compose --profile proxy up -d).
# DOMAIN=links.example.com
# LOG_LEVEL=info          # fatal, error, warn, info, debug, trace

# Only for running without Docker (npm run dev). Docker sets these itself.
# DATA_DIR=./data
# WWEBJS_AUTH_DIR=./.wwebjs_auth
# WWEBJS_CACHE_DIR=./.wwebjs_cache
# HEADLESS=true
